uint8 GO_HOME=0                   # G28: travel to home
uint8 FIND_HOME=1                 # F11/F12/F13: seek endstop per selected axis
uint8 CALIBRATE=2                 # F14/F15/F16
uint8 SET_HOME=3                  # F84: declare current position as home
uint8 op
bool x
bool y
bool z
---
uint8 OK=0
uint8 FIRMWARE_ERROR=1            # firmware replied R03
uint8 ESTOPPED=2                  # e-stop fired while moving
uint8 ABORTED=3                   # '@' abort while moving
uint8 REJECTED=4                  # goal were rejected
uint8 code
string message
---
geometry_msgs/Point position