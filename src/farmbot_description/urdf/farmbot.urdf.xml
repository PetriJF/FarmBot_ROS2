<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="farmbot">

<xacro:property name="length" value="6" />
<xacro:property name="width" value="3" />
<xacro:property name="height" value="1" />
<xacro:property name="thickness" value="0.1" />

<material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
</material>

<material name="green">
    <color rgba="0 1 0 1"/>
</material>

<material name="red">
    <color rgba="1 0 0 1"/>
</material>

<material name="blue">
    <color rgba="0 0 1 1"/>
 </material>

<xacro:macro name="racks">
    <geometry>
        <box size="${thickness} ${length} ${thickness}"/>
    </geometry>
    <material name="grey"/>
</xacro:macro>

<xacro:macro name="gantry_legs">
    <geometry>
        <box size="${thickness} ${thickness} ${height - thickness}"/>
    </geometry>
    <material name="red"/>
</xacro:macro>

  ####### Racks structure
  <link name="base_link"/>

  <link name="base_right_rack">
    <visual>
      <xacro:racks/>
    </visual>
  </link>

  <link name="base_left_rack">
    <visual>
      <xacro:racks/>
    </visual>
  </link>

  <joint name="base_link_to_right_rack" type="fixed">
    <parent link="base_link"/>
    <child link="base_right_rack"/>
    <origin xyz="${thickness/2} -${length/2} -${thickness/2}"/>
  </joint>

  <joint name="base_link_to_left_rack" type="fixed">
    <parent link="base_link"/>
    <child link="base_left_rack"/>
    <origin xyz="${width - thickness/2} -${length/2} -${thickness/2}"/>
  </joint>

  ####### y_carriage structure
  <link name="gantry_right_leg">
    <visual>
      <xacro:gantry_legs/>
    </visual>
  </link>

  <link name="gantry_left_leg">
    <visual>
      <xacro:gantry_legs/>
    </visual>
  </link>

  <link name="gantry">
    <visual>
      <geometry>
        <box size="${width} ${thickness} ${thickness}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="gantry_to_rack" type="prismatic">
    <parent link="base_right_rack"/>
    <child link="gantry"/>
    <axis xyz="0 -1 0"/>
    <origin xyz="${width/2 - thickness/2} ${length/2 - thickness/2} ${height}"/>
    <limit lower="0" upper="${length - thickness}" effort="100" velocity="0.5"/>
  </joint>

  <joint name="gantry_right_leg_to_gantry" type="fixed">
    <parent link="gantry"/>
    <child link="gantry_right_leg"/>
    <origin xyz="-${width/2 - thickness/2} 0 -${height/2}"/>
  </joint>

  <joint name="gantry_left_leg_to_gantry" type="fixed">
    <parent link="gantry"/>
    <child link="gantry_left_leg"/>
    <origin xyz="${width/2 - thickness/2} 0 -${height/2}"/>
  </joint>

####### x_carriage structure
  <link name="x_carriage">
    <visual>
      <geometry>
        <box size="${3*thickness} ${thickness} ${thickness/2}"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="x_carriage_to_gantry" type="prismatic">
    <parent link="gantry"/>
    <child link="x_carriage"/>
    <axis xyz="1 0 0"/>
    <origin xyz="-${(width - 3*thickness)/2} 0 ${3*thickness/4}"/>
    <limit lower="0" upper="${width - 3*thickness}" effort="100" velocity="0.5"/>
  </joint>

####### z_carriage structure
  <link name="z_carriage">
    <visual>
      <geometry>
        <cylinder length="${height - thickness}" radius="${thickness/5}"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="z_carriage_to_x_carriage" type="prismatic">
    <parent link="x_carriage"/>
    <child link="z_carriage"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <limit lower="-${height/2 - thickness}" upper="${height/2 - 2*thickness}" effort="100" velocity="0.5"/>
  </joint>

</robot>